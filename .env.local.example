# ============================================================
# Z-Agent — variables de entorno
# Copia este archivo a .env.local y llena los valores reales.
# ============================================================

# ─── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=
# Opcional: cambia el modelo si lo necesitas (default: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# ─── Meta WhatsApp Business ────────────────────────────────
# Token aleatorio (32+ chars) que tú defines y registras en Meta
WEBHOOK_VERIFY_TOKEN=
# App Secret de la app de Meta (Settings → Basic)
META_APP_SECRET=

# ─── Admin panel ───────────────────────────────────────────
# Contraseña del panel /admin. Genera con: openssl rand -hex 32
ADMIN_SECRET=

# ─── Upstash Redis (rate limiting) ─────────────────────────
# Crea una BD en https://console.upstash.com/redis y copia los valores REST.
# Si dejas estos vacíos, el rate limiting se desactiva (NO recomendado en producción).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Vercel Cron (HubSpot polling) ─────────────────────────
# Secret aleatorio que Vercel Cron envía como Bearer token al endpoint
# /api/cron/check-deals. Genera con: openssl rand -hex 32
CRON_SECRET=
