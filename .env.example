# ============================================================
# Z-Agent — variables de entorno (plantilla)
# Copia este archivo a .env.local y llena los valores reales:
#   cp .env.example .env.local
# Nunca pongas valores reales en este archivo: es público.
# En producción, estas mismas variables van en Vercel.
# ============================================================

# ─── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Clave service_role: salta RLS. Solo en el servidor, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: clave anon. Hoy el código no la usa.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Claude (Anthropic) ────────────────────────────────────
ANTHROPIC_API_KEY=
# Opcional: modelo del agente (por defecto claude-sonnet-5-5)
# AGENT_MODEL=

# ─── Webhook de WhatsApp ───────────────────────────────────
# Token que tú defines y registras en Meta al verificar el webhook
WEBHOOK_VERIFY_TOKEN=
# App Secret de la app de Meta (verifica la firma x-hub-signature-256)
META_APP_SECRET=
# Secreto del webhook de Kapso (verifica la firma x-webhook-signature)
KAPSO_WEBHOOK_SECRET=
# Los tokens de envío de WhatsApp y de HubSpot NO van aquí: viven en la
# tabla `tenants` de Supabase (uno por cliente) y se editan desde /admin.

# ─── Panel de administración ───────────────────────────────
# Contraseña del panel /admin. Genera con: openssl rand -hex 32
ADMIN_SECRET=

# ─── Upstash Redis (rate limiting y deduplicación) ─────────
# Si quedan vacías, el rate limiting se desactiva. En producción son obligatorias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Vercel Cron ───────────────────────────────────────────
# Bearer que Vercel Cron envía a /api/cron/*. Genera con: openssl rand -hex 32
CRON_SECRET=
